{
  "name": "horizon-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "HorizonMobile：深空矩阵新视野的 Android App（AEMobileApp 底座迁移）",
  "scripts": {
    "postinstall": "node patch-rn-screens.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node dist-test/test/protocol-unit.js && node dist-test/test/e2e.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@noble/hashes": "^1.4.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@types/react": "^18.3.31",
    "buffer": "^6.0.3",
    "expo": "^51.0.39",
    "expo-build-properties": "^0.12.5",
    "react": "^18.2.0",
    "react-native": "^0.74.3",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-tcp-socket": "^6.4.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "main": "index.js"
}
